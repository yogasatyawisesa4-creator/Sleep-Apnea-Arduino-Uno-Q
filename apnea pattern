def load_class(folder, label, max_files=MAX_FILES):
    files = sorted(glob.glob(os.path.join(folder, "*.wav")))[:max_files]
    feats    = []
    rms_vals = []
    errors   = 0
    print(f"\n  Kelas {label} ({os.path.basename(folder)}): {len(files)} file")
    for i, fp in enumerate(files):
        if i % 500 == 0:
            pct = i / len(files) * 100
            print(f"\r    Progress: {i}/{len(files)} ({pct:.0f}%)", end="", flush=True)
        try:
            audio, _ = librosa.load(fp, sr=SR, mono=True)
            feat = extract_features(audio)
            rms_val = float(np.sqrt(np.mean(audio ** 2)))
            feats.append(feat)
            rms_vals.append(rms_val)
        except Exception:
            errors += 1
    pct = 100
    print(f"\r    Selesai: {len(feats)}/{len(files)} file OK, {errors} error   ")
    X = np.array(feats, dtype=np.float32)
    y = np.full(len(feats), label, dtype=int)
    return X, y, np.array(rms_vals, dtype=np.float32)

