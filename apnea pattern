# 1. EKSTRAKSI FITUR PER-SEGMEN (1 detik)
# ─────────────────────────────────────────────
def extract_features(audio, sr=SR):
    """
    Ekstrak 43 fitur dari 1 segmen audio (1 detik) @ 4000 Hz:
      - MFCC mean (13) + std (13) = 26 fitur
      - Delta-MFCC mean (13) dengan width=3 = 13 fitur  [width < n_frames=8]
      - RMS Energy (1), ZCR (1), Spec Centroid (1), Rolloff (1), Bandwidth (1) = 5
    Total: 44 fitur
    """
    # Pastikan panjang minimal
    if len(audio) < 2048:
        audio = np.pad(audio, (0, 2048 - len(audio)))

    # MFCC (13 koefisien, 8 frame)
    mfcc       = librosa.feature.mfcc(y=audio, sr=sr, n_mfcc=N_MFCC)
    mfcc_mean  = np.mean(mfcc, axis=1)   # shape: (13,)
    mfcc_std   = np.std(mfcc, axis=1)    # shape: (13,)

    # Delta MFCC dengan width=3 (aman untuk 8 frame)
    delta_mfcc = librosa.feature.delta(mfcc, width=DELTA_WIDTH)
    delta_mean = np.mean(delta_mfcc, axis=1)  # shape: (13,)

    # Energy & Spectral features
    rms        = float(np.sqrt(np.mean(audio ** 2)))
    zcr        = float(np.mean(librosa.feature.zero_crossing_rate(audio)))
    spec_cent  = float(np.mean(librosa.feature.spectral_centroid(y=audio, sr=sr)))
    spec_roll  = float(np.mean(librosa.feature.spectral_rolloff(y=audio, sr=sr)))
    spec_bw    = float(np.mean(librosa.feature.spectral_bandwidth(y=audio, sr=sr)))

    feat = np.concatenate([
        mfcc_mean, mfcc_std, delta_mean,
        [rms, zcr, spec_cent, spec_roll, spec_bw]
    ])
    return feat.astype(np.float32)

