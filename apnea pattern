def get_segment_types(rms_array, threshold):
    return ['snoring' if r > threshold else 'silence' for r in rms_array]

def find_apnea_events(seg_types, min_silence_sec=APNEA_SILENCE_THRESHOLD):
    """Cari: snoring -> silence (>=min_silence_sec frame) -> snoring"""
    events = []
    n = len(seg_types)
    i = 0
    while i < n:
        if seg_types[i] == 'snoring':
            # Skip snoring run
            j = i
            while j < n and seg_types[j] == 'snoring':
                j += 1
            # Check silence run
            if j < n and seg_types[j] == 'silence':
                sil_start = j
                while j < n and seg_types[j] == 'silence':
                    j += 1
                sil_end = j
                sil_dur = sil_end - sil_start
                # Check snoring resumes after silence
                if sil_dur >= min_silence_sec and j < n and seg_types[j] == 'snoring':
                    events.append({
                        'snore_start': i, 'silence_start': sil_start,
                        'silence_end': sil_end, 'silence_dur': sil_dur,
                        'snore_resume': j
                    })
            i = j if j > i else i + 1
        else:
            i += 1
    return events

def analyze_pattern(rms_vals, label_name, max_analyze=200):
    rms_sub = rms_vals[:max_analyze]
    segs    = get_segment_types(rms_sub, rms_threshold)
    events  = find_apnea_events(segs)
    counts  = Counter(segs)
    total   = len(segs)
    print(f"\n  [{label_name}] - Analisis {total} detik:")
    print(f"    NGOROK : {counts.get('snoring',0):4d} seg ({counts.get('snoring',0)/total*100:.1f}%)")
    print(f"    HENING : {counts.get('silence',0):4d} seg ({counts.get('silence',0)/total*100:.1f}%)")
    print(f"    Event Apnea (hening >={APNEA_SILENCE_THRESHOLD}s) terdeteksi: {len(events)}")
    for ev in events[:5]:
        print(f"      -> Det.{ev['snore_start']+1} ngorok | "
              f"Hening {ev['silence_dur']}s (det.{ev['silence_start']+1}-{ev['silence_end']}) | "
              f"Ngorok lagi det.{ev['snore_resume']+1}")
    return segs, events

