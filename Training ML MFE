"""
Snoring Detection - Retrain dengan MFE LogFBank
=================================================
Fitur: python_speech_features.logfbank (50 frames × 40 filters = 2000 fitur)
Pipeline: MFE -> StandardScaler -> PCA -> Model (ANN/KNN/SVM)
Output: PKL files yang kompatibel dengan main_inference.py di Arduino
"""

import os
import sys
import warnings
import time
import numpy as np
import wave
import struct
import joblib
import python_speech_features
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.metrics import (
    classification_report, confusion_matrix, accuracy_score,
    precision_score, recall_score, f1_score, roc_curve, auc,
    precision_recall_curve
)
from sklearn.neural_network import MLPClassifier
from sklearn.neighbors import KNeighborsClassifier
from sklearn.svm import SVC

warnings.filterwarnings('ignore')

# ============================================================
# Configuration
# ============================================================
DATASET_DIR = r"d:\TA_AGOY\Snoring Dataset"
OUTPUT_DIR = r"d:\TA_AGOY\Snoring Dataset"
MODEL_DIR = os.path.join(OUTPUT_DIR, "models")
PLOT_DIR = os.path.join(OUTPUT_DIR, "plots")

os.makedirs(MODEL_DIR, exist_ok=True)
os.makedirs(PLOT_DIR, exist_ok=True)

SAMPLE_RATE = 16000
TEST_SIZE = 0.2
RANDOM_STATE = 32
N_PCA_COMPONENTS = 50  # Reduksi dimensi dari 2000 -> 50

CLASS_NAMES = ['Normal', 'Snoring']


# ============================================================
# 1. Feature Extraction (MFE LogFBank) — sama dengan inference
# ============================================================
def normalize_audio(audio_array):
    """
    Melakukan Peak Normalization pada raw audio PCM int16.
    Ini akan mengangkat volume audio yang sangat kecil menjadi standar (maksimum).
    """
    audio_float = audio_array.astype(np.float32)
    max_val = np.max(np.abs(audio_float))
    if max_val > 0:
        audio_float = (audio_float / max_val) * 32767.0
    return audio_float.astype(np.int16)


def read_wav_as_int16(file_path):
    """Baca file WAV dan kembalikan array int16."""
    with wave.open(file_path, 'rb') as wf:
        n_channels = wf.getnchannels()
        sampwidth = wf.getsampwidth()
        framerate = wf.getframerate()
        n_frames = wf.getnframes()
        raw = wf.readframes(n_frames)

    # Convert ke int16
    if sampwidth == 2:
        audio = np.frombuffer(raw, dtype=np.int16)
    elif sampwidth == 1:
        audio = np.frombuffer(raw, dtype=np.uint8).astype(np.int16) - 128
        audio = audio * 256
    else:
        audio = np.frombuffer(raw, dtype=np.int16)

    # Jika stereo, ambil channel pertama
    if n_channels == 2:
        audio = audio[::2]

    return audio, framerate


def extract_mfe_features(file_path):
    """
    Ekstrak fitur MFE LogFBank dari file WAV.
    Sama persis dengan yang dipakai di main_inference.py:
      python_speech_features.logfbank(audio, 16000, winlen=0.02, winstep=0.02, nfilt=40, nfft=512)
    Menghasilkan 50 frames × 40 filters = 2000 fitur (untuk audio 1 detik).
    """
    try:
        audio, sr = read_wav_as_int16(file_path)

        # Resample jika perlu
        if sr != SAMPLE_RATE:
            ratio = SAMPLE_RATE / sr
            new_len = int(len(audio) * ratio)
            audio = np.interp(
                np.linspace(0, len(audio) - 1, new_len),
                np.arange(len(audio)),
                audio.astype(float)
            ).astype(np.int16)

        # Padding / Cut persis 16000 sample (1 detik)
        expected_len = SAMPLE_RATE
        if len(audio) > expected_len:
            audio = audio[:expected_len]
        elif len(audio) < expected_len:
            audio = np.pad(audio, (0, expected_len - len(audio)), 'constant')

        # NORMALISASI VOLUME AUDIO (agar sinkron dengan volume mic Raspberry Pi)
        audio = normalize_audio(audio)

        # Ekstrak MFE LogFBank — IDENTIK dengan inference
        mfe = python_speech_features.logfbank(
            audio,
            SAMPLE_RATE,
            winlen=0.02,
            winstep=0.02,
            nfilt=40,
            nfft=512
        )

        return mfe.flatten()

    except Exception as e:
        print(f"  [ERROR] {file_path}: {e}")
        return None


def load_dataset():
    """Load dan ekstrak fitur MFE dari seluruh dataset."""
    features = []
    labels = []

    for label in [0, 1]:
        folder = os.path.join(DATASET_DIR, str(label))
        files = sorted([f for f in os.listdir(folder) if f.endswith('.wav')])
        if len(files) > 2000:
            import random
            random.seed(42)
            files = random.sample(files, 2000)
        total = len(files)
        print(f"\n{'='*60}")
        print(f"Processing class {label} ({CLASS_NAMES[label]}): {total} files")
        print(f"{'='*60}")

        for i, fname in enumerate(files):
            if (i + 1) % 100 == 0 or i == 0:
                print(f"  [{i+1}/{total}] {fname}...")

            fpath = os.path.join(folder, fname)
            feat = extract_mfe_features(fpath)

            if feat is not None:
                features.append(feat)
                labels.append(label)

    X = np.array(features)
    y = np.array(labels)
    print(f"\nDataset: {X.shape[0]} samples, {X.shape[1]} fitur MFE")
    print(f"  Normal: {np.sum(y == 0)}, Snoring: {np.sum(y == 1)}")
    return X, y


# ============================================================
# 2. Plot Utilities
# ============================================================
def plot_confusion_matrix(y_true, y_pred, model_name):
    cm = confusion_matrix(y_true, y_pred)
    fig, ax = plt.subplots(figsize=(8, 6))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
                xticklabels=CLASS_NAMES, yticklabels=CLASS_NAMES,
                annot_kws={'size': 18}, ax=ax)
    ax.set_xlabel('Predicted Label', fontsize=14)
    ax.set_ylabel('True Label', fontsize=14)
    ax.set_title(f'Confusion Matrix - {model_name}', fontsize=16, fontweight='bold')
    plt.tight_layout()
    fpath = os.path.join(PLOT_DIR, f'confusion_matrix_{model_name.lower()}.png')
    plt.savefig(fpath, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {fpath}")
    return cm


def plot_roc_curve(y_true, y_scores, model_name):
    fpr, tpr, _ = roc_curve(y_true, y_scores)
    roc_auc = auc(fpr, tpr)
    fig, ax = plt.subplots(figsize=(8, 6))
    ax.plot(fpr, tpr, color='#2196F3', lw=2.5, label=f'{model_name} (AUC = {roc_auc:.4f})')
    ax.plot([0, 1], [0, 1], 'k--', lw=1.5, alpha=0.5)
    ax.fill_between(fpr, tpr, alpha=0.15, color='#2196F3')
    ax.set_xlim([-0.02, 1.02]); ax.set_ylim([-0.02, 1.02])
    ax.set_xlabel('False Positive Rate', fontsize=13)
    ax.set_ylabel('True Positive Rate', fontsize=13)
    ax.set_title(f'ROC Curve - {model_name}', fontsize=16, fontweight='bold')
    ax.legend(loc='lower right', fontsize=12); ax.grid(True, alpha=0.3)
    plt.tight_layout()
    fpath = os.path.join(PLOT_DIR, f'roc_curve_{model_name.lower()}.png')
    plt.savefig(fpath, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {fpath}")
    return roc_auc


def plot_pr_curve(y_true, y_scores, model_name):
    precision, recall, _ = precision_recall_curve(y_true, y_scores)
    fig, ax = plt.subplots(figsize=(8, 6))
    ax.plot(recall, precision, color='#FF5722', lw=2.5)
    ax.fill_between(recall, precision, alpha=0.15, color='#FF5722')
    ax.set_xlabel('Recall', fontsize=13); ax.set_ylabel('Precision', fontsize=13)
    ax.set_title(f'Precision-Recall Curve - {model_name}', fontsize=16, fontweight='bold')
    ax.grid(True, alpha=0.3)
    plt.tight_layout()
    fpath = os.path.join(PLOT_DIR, f'pr_curve_{model_name.lower()}.png')
    plt.savefig(fpath, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {fpath}")


def plot_ann_loss(clf):
    fig, ax = plt.subplots(figsize=(10, 6))
    ax.plot(clf.loss_curve_, color='#E91E63', lw=2, label='Training Loss')
    ax.set_xlabel('Epoch', fontsize=13); ax.set_ylabel('Loss', fontsize=13)
    ax.set_title('Training Loss Curve - ANN', fontsize=16, fontweight='bold')
    ax.legend(fontsize=12); ax.grid(True, alpha=0.3)
    plt.tight_layout()
    fpath = os.path.join(PLOT_DIR, 'training_loss_ann.png')
    plt.savefig(fpath, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {fpath}")


def plot_comparison(results):
    models = list(results.keys())
    metrics = ['Accuracy', 'Precision', 'Recall', 'F1-Score']
    colors = ['#2196F3', '#4CAF50', '#FF9800', '#E91E63']
    x = np.arange(len(models)); width = 0.18

    fig, ax = plt.subplots(figsize=(12, 7))
    for i, metric in enumerate(metrics):
        values = [results[m][metric] for m in models]
        bars = ax.bar(x + i * width, values, width, label=metric, color=colors[i], edgecolor='white')
        for bar, val in zip(bars, values):
            ax.text(bar.get_x() + bar.get_width()/2., bar.get_height() + 0.005,
                    f'{val:.3f}', ha='center', va='bottom', fontsize=9, fontweight='bold')

    ax.set_xlabel('Model', fontsize=14); ax.set_ylabel('Score', fontsize=14)
    ax.set_title('Model Performance Comparison', fontsize=18, fontweight='bold')
    ax.set_xticks(x + width * 1.5); ax.set_xticklabels(models, fontsize=12)
    ax.set_ylim(0, 1.15); ax.legend(fontsize=11); ax.grid(True, alpha=0.2, axis='y')
    plt.tight_layout()
    fpath = os.path.join(PLOT_DIR, 'model_comparison.png')
    plt.savefig(fpath, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {fpath}")


def plot_roc_comparison(roc_data):
    fig, ax = plt.subplots(figsize=(9, 7))
    colors = ['#2196F3', '#4CAF50', '#FF9800']
    for (name, y_true, y_scores), color in zip(roc_data, colors):
        fpr, tpr, _ = roc_curve(y_true, y_scores)
        roc_auc = auc(fpr, tpr)
        ax.plot(fpr, tpr, color=color, lw=2.5, label=f'{name} (AUC = {roc_auc:.4f})')
    ax.plot([0, 1], [0, 1], 'k--', lw=1.5, alpha=0.5)
    ax.set_xlim([-0.02, 1.02]); ax.set_ylim([-0.02, 1.02])
    ax.set_xlabel('FPR', fontsize=13); ax.set_ylabel('TPR', fontsize=13)
    ax.set_title('ROC Curve Comparison - All Models', fontsize=16, fontweight='bold')
    ax.legend(loc='lower right', fontsize=11); ax.grid(True, alpha=0.3)
    plt.tight_layout()
    fpath = os.path.join(PLOT_DIR, 'roc_comparison.png')
    plt.savefig(fpath, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {fpath}")


# ============================================================
# 3. Evaluate
# ============================================================
def evaluate_model(model, X_test, y_test, model_name):
    y_pred = model.predict(X_test)
    if hasattr(model, 'predict_proba'):
        y_scores = model.predict_proba(X_test)[:, 1]
    elif hasattr(model, 'decision_function'):
        y_scores = model.decision_function(X_test)
    else:
        y_scores = y_pred.astype(float)

    acc  = accuracy_score(y_test, y_pred)
    prec = precision_score(y_test, y_pred, average='weighted')
    rec  = recall_score(y_test, y_pred, average='weighted')
    f1   = f1_score(y_test, y_pred, average='weighted')

    print(f"\n{'='*60}")
    print(f"  {model_name} - Evaluation Results")
    print(f"{'='*60}")
    print(f"  Accuracy:  {acc:.4f} ({acc*100:.2f}%)")
    print(f"  Precision: {prec:.4f}")
    print(f"  Recall:    {rec:.4f}")
    print(f"  F1-Score:  {f1:.4f}")
    print(f"\n{classification_report(y_test, y_pred, target_names=CLASS_NAMES)}")

    plot_confusion_matrix(y_test, y_pred, model_name)
    roc_auc = plot_roc_curve(y_test, y_scores, model_name)
    plot_pr_curve(y_test, y_scores, model_name)

    return {'Accuracy': acc, 'Precision': prec, 'Recall': rec, 'F1-Score': f1, 'AUC': roc_auc}, y_scores


# ============================================================
# 4. Main
# ============================================================
def main():
    print("\n" + "=" * 70)
    print("   SNORING DETECTION - TRAINING (MFE LogFBank Pipeline)")
    print("   Fitur: python_speech_features.logfbank -> Scaler -> PCA -> Model")
    print("=" * 70)

    # --- Load Dataset ---
    print("\n[STEP 1] Ekstraksi fitur MFE dari dataset...")
    t0 = time.time()
    X, y = load_dataset()
    print(f"  Selesai dalam {time.time()-t0:.1f}s")

    # --- Split & Scale & PCA ---
    print(f"\n[STEP 2] Split 80/20, StandardScaler, PCA({N_PCA_COMPONENTS})...")
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=TEST_SIZE, random_state=RANDOM_STATE, stratify=y
    )

    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    X_test_scaled  = scaler.transform(X_test)

    pca = PCA(n_components=N_PCA_COMPONENTS, random_state=RANDOM_STATE)
    X_train_pca = pca.fit_transform(X_train_scaled)
    X_test_pca  = pca.transform(X_test_scaled)

    print(f"  Train: {X_train_pca.shape}, Test: {X_test_pca.shape}")
    print(f"  PCA variance explained: {pca.explained_variance_ratio_.sum():.4f}")

    results = {}
    roc_data = []

    # ========== ANN ==========
    print("\n" + "=" * 70)
    print("  [STEP 3] Training ANN (MLPClassifier)")
    print("=" * 70)

    ann = MLPClassifier(
        hidden_layer_sizes=(128, 64, 32),
        activation='relu', solver='adam',
        max_iter=500, random_state=RANDOM_STATE,
        early_stopping=True, validation_fraction=0.15,
        learning_rate='adaptive', learning_rate_init=0.001,
        batch_size=32, verbose=False
    )
    t0 = time.time()
    ann.fit(X_train_pca, y_train)
    ann_time = time.time() - t0
    print(f"  Training time: {ann_time:.2f}s, Epochs: {ann.n_iter_}")
    plot_ann_loss(ann)

    metrics, y_scores = evaluate_model(ann, X_test_pca, y_test, "ANN")
    metrics['Time'] = ann_time
    results['ANN'] = metrics
    roc_data.append(('ANN', y_test, y_scores))

    # Simpan ANN: model + scaler + pca (masing-masing per model)
    joblib.dump(ann,    os.path.join(MODEL_DIR, 'ann_model.pkl'))
    joblib.dump(scaler, os.path.join(MODEL_DIR, 'ann_scaler.pkl'))
    joblib.dump(pca,    os.path.join(MODEL_DIR, 'ann_pca.pkl'))
    print(f"  Saved: ann_model.pkl, ann_scaler.pkl, ann_pca.pkl")

    # ========== KNN ==========
    print("\n" + "=" * 70)
    print("  [STEP 4] Training KNN")
    print("=" * 70)

    knn = KNeighborsClassifier(n_neighbors=7, weights='distance', metric='minkowski', p=2, n_jobs=-1)
    t0 = time.time()
    knn.fit(X_train_pca, y_train)
    knn_time = time.time() - t0
    print(f"  Training time: {knn_time:.2f}s")

    metrics, y_scores = evaluate_model(knn, X_test_pca, y_test, "KNN")
    metrics['Time'] = knn_time
    results['KNN'] = metrics
    roc_data.append(('KNN', y_test, y_scores))

    joblib.dump(knn,    os.path.join(MODEL_DIR, 'knn_model.pkl'))
    joblib.dump(scaler, os.path.join(MODEL_DIR, 'knn_scaler.pkl'))
    joblib.dump(pca,    os.path.join(MODEL_DIR, 'knn_pca.pkl'))
    print(f"  Saved: knn_model.pkl, knn_scaler.pkl, knn_pca.pkl")

    # ========== SVM ==========
    print("\n" + "=" * 70)
    print("  [STEP 5] Training SVM")
    print("=" * 70)

    svm = SVC(kernel='rbf', C=10.0, gamma='scale', probability=True,
              random_state=RANDOM_STATE, class_weight='balanced')
    t0 = time.time()
    svm.fit(X_train_pca, y_train)
    svm_time = time.time() - t0
    print(f"  Training time: {svm_time:.2f}s")

    metrics, y_scores = evaluate_model(svm, X_test_pca, y_test, "SVM")
    metrics['Time'] = svm_time
    results['SVM'] = metrics
    roc_data.append(('SVM', y_test, y_scores))

    joblib.dump(svm,    os.path.join(MODEL_DIR, 'svm_model.pkl'))
    joblib.dump(scaler, os.path.join(MODEL_DIR, 'svm_scaler.pkl'))
    joblib.dump(pca,    os.path.join(MODEL_DIR, 'svm_pca.pkl'))
    print(f"  Saved: svm_model.pkl, svm_scaler.pkl, svm_pca.pkl")

    # ========== Comparison Plots ==========
    print("\n" + "=" * 70)
    print("  [STEP 6] Comparison Charts")
    print("=" * 70)
    plot_comparison(results)
    plot_roc_comparison(roc_data)

    # ========== Summary ==========
    print("\n\n" + "=" * 80)
    print("  FINAL RESULTS")
    print("=" * 80)
    print(f"  {'Model':<8} {'Accuracy':>10} {'Precision':>10} {'Recall':>10} {'F1':>10} {'AUC':>8} {'Time':>8}")
    print("  " + "-" * 68)
    for name, m in results.items():
        print(f"  {name:<8} {m['Accuracy']:>10.4f} {m['Precision']:>10.4f} {m['Recall']:>10.4f} {m['F1-Score']:>10.4f} {m['AUC']:>8.4f} {m['Time']:>7.2f}s")
    print("=" * 80)

    best = max(results, key=lambda k: results[k]['Accuracy'])
    print(f"\n  Best: {best} ({results[best]['Accuracy']*100:.2f}%)")

    print(f"\n  PKL files untuk Arduino/Raspi ({MODEL_DIR}):")
    for name in ['ann', 'knn', 'svm']:
        print(f"    {name}_model.pkl, {name}_scaler.pkl, {name}_pca.pkl")
    print("\n  DONE!")


if __name__ == '__main__':
    main()
